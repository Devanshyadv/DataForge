6.953167Z", "completed_at": "2026-06-04T11:49:26.969707Z"}, {"name": "execute", "started_at": "2026-06-04T11:49:26.972392Z", "completed_at": "2026-06-04T11:49:26.972400Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.029119491577148438, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dataforge.unique_dim_customer_customer_key.7b0683cc6e", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    customer_key as unique_field,\n    count(*) as n_records\n\nfrom \"dataforge\".\"warehouse\".\"dim_customer\"\nwhere customer_key is not null\ngroup by customer_key\nhaving count(*) > 1\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-04T11:49:26.958813Z", "completed_at": "2026-06-04T11:49:26.970411Z"}, {"name": "execute", "started_at": "2026-06-04T11:49:26.973298Z", "completed_at": "2026-06-04T11:49:26.973304Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.02918386459350586, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dataforge.fact_orders", "compiled": true, "compiled_code": "/*\n  Grain: one row per order_item (the most granular fact in this dataset).\n  payment_value is an order-level measure distributed to each item row \u2014\n  aggregate it with SUM(DISTINCT order_id, payment_value) or filter to\n  item_id = 1 when calculating order-level payment totals in BI queries.\n*/\n\nwith order_items as (\n    select * from \"dataforge\".\"staging\".\"stg_order_items\"\n),\n\norders as (\n    select * from \"dataforge\".\"staging\".\"stg_orders\"\n),\n\npayments as (\n    select\n        order_id,\n        sum(payment_value) as total_payment_value\n    from \"dataforge\".\"staging\".\"stg_order_payments\"\n    group by order_id\n),\n\ndim_customer as (\n    select customer_key, customer_id from \"dataforge\".\"warehouse\".\"dim_customer\"\n),\n\ndim_product as (\n    select product_key, product_id from \"dataforge\".\"warehouse\".\"dim_product\"\n),\n\ndim_date as (\n    select date_key, full_date from \"dataforge\".\"warehouse\".\"dim_date\"\n)\n\nselect\n    -- surrogate key\n    md5(oi.order_id || '-' || oi.order_item_id::text)  as order_item_key,\n\n    -- natural / degenerate keys\n    oi.order_id,\n    oi.order_item_id,\n    o.order_status,\n\n    -- foreign keys to dimensions\n    dc.customer_key,\n    dp.product_key,\n    dd.date_key,\n\n    -- measures\n    oi.price,\n    oi.freight_value,\n    p.total_payment_value   as payment_value\n\nfrom order_items oi\ninner join orders o\n    on oi.order_id = o.order_id\nleft  join payments p\n    on o.order_id = p.order_id\nleft  join dim_customer dc\n    on o.customer_id = dc.customer_id\nleft  join dim_product dp\n    on oi.product_id = dp.product_id\nleft  join dim_date dd\n    on o.purchased_at::date = dd.full_date", "relation_name": "\"dataforge\".\"warehouse\".\"fact_orders\""}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-04T11:49:26.963057Z", "completed_at": "2026-06-04T11:49:26.971997Z"}, {"name": "execute", "started_at": "2026-06-04T11:49:26.974922Z", "completed_at": "2026-06-04T11:49:26.974929Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.029279470443725586, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dataforge.not_null_dim_product_category_name.e2fc98b446", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category_name\nfrom \"dataforge\".\"warehouse\".\"dim_product\"\nwhere category_name is null\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-04T11:49:26.982979Z", "completed_at": "2026-06-04T11:49:26.996854Z"}, {"name": "execute", "started_at": "2026-06-04T11:49:26.999667Z", "completed_at": "2026-06-04T11:49:26.999676Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.02233409881591797, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dataf